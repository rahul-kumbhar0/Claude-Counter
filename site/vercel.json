{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/wiggleroom-extension.zip", "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"wiggleroom-extension.zip\"" }, { "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "X-Frame-Options", "value": "SAMEORIGIN" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ]
}
